# Copy to .env. Variables are read by the backend (prefix ANNA_) and the model server.
ANNA_LLM_PROVIDER=openai          # openai = any OpenAI-compatible server such as vLLM; mock = no model
ANNA_LLM_BASE_URL=http://127.0.0.1:8001/v1
ANNA_LLM_MODEL=google/medgemma-1.5-4b-it
ANNA_LEARNER_NAME=Anna
ANNA_APP_PASSWORD=                # set a shared password before exposing the app
HF_TOKEN=                         # Hugging Face token with MedGemma terms accepted
HF_HOME=/scratch/tgrogers-disk01/a/chris241/hf_cache   # where model weights are cached (default ~/.cache/huggingface)

# Extra browser origins allowed to call the API (JSON list). The GitHub Pages origin is built in.
# ANNA_CORS_ORIGINS=["http://localhost:3000","https://christindbose.github.io"]
